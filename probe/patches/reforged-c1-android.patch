diff --git a/GeneralsMD/Code/Tools/ffmpeg-build-posix.sh b/GeneralsMD/Code/Tools/ffmpeg-build-posix.sh
index f48d3ab..03fc8ae 100755
--- a/GeneralsMD/Code/Tools/ffmpeg-build-posix.sh
+++ b/GeneralsMD/Code/Tools/ffmpeg-build-posix.sh
@@ -64,7 +64,11 @@ version=8.1.2
 
 rm -rf "$work" "$prefix"
 mkdir -p "$work/build"
-tar -xf "$tarball" -C "$work"
+# Stage C (C1): --no-same-owner — as root inside a user namespace (CI sandboxes,
+# Android build containers) tar's ownership restore is refused and exits
+# nonzero although every file extracted; ownership of a throwaway build tree
+# is never load-bearing. A no-op for non-root users.
+tar --no-same-owner -xf "$tarball" -C "$work"
 source="$work/ffmpeg-$version"
 if [ ! -x "$source/configure" ]; then
   echo "ffmpeg-build-posix: $tarball did not unpack to ffmpeg-$version" >&2
