+// (C5 smoothness, v1.24) ZH_RENDER_SCALE: the scene renders into this frame's offscreen
+// targets and Present_Into upscales them to the swapchain, so scaling the targets scales
+// the whole pipeline's fill cost -- 0.75 takes 44% of the pixels away. Read once; the
+// launcher sets it before the engine starts. Default 1.0 = unchanged. The stored
+// BackWidth/BackHeight carry the scaled size, so viewports, the present log line and
+// every consumer stay consistent with the textures actually created.
+static float Sdl_Render_Scale()
+{
+	static float scale = -1.0f;
+	if (scale < 0.0f) {
+		scale = 1.0f;
+		const char *env = getenv("ZH_RENDER_SCALE");
+		if (env != NULL && env[0] != '\0') {
+			const float v = (float)atof(env);
+			if (v >= 0.5f && v <= 1.0f)
+				scale = v;
+		}
+		if (scale < 1.0f)
+			fprintf(stderr, "SdlGpuFrame: ZH_RENDER_SCALE=%.2f\n", scale);
+	}
+	return scale;
+}
+
 bool SdlGpuFrame::Create_Targets(unsigned int width, unsigned int height)
 {
+	const float renderScale = Sdl_Render_Scale();
+	if (renderScale < 1.0f) {
+		width = (unsigned int)(width * renderScale + 0.5f);
+		height = (unsigned int)(height * renderScale + 0.5f);
+		if (width < 1) width = 1;
+		if (height < 1) height = 1;
+	}
 	SDL_GPUTextureCreateInfo info;
 	SDL_zero(info);
 	info.type = SDL_GPU_TEXTURETYPE_2D;
