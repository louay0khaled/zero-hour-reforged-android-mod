+// -----------------------------------------------------------------------------
+// GeneralsX persistent shader cache 20/11/2026 (v1.25): the SPIR-V a program
+// compiles to is written to <ZH_USER_DATA_DIR>/shadercache/<hash>.spv and read
+// back on the next launch, so glslang runs once per program per device instead
+// of once per program per launch.  The key is an FNV-1a hash of the stage and
+// the exact HLSL the generator produced; a file that fails the SPIR-V magic or
+// size checks, or whose shader the device refuses, is dropped and recompiled.
+// ZH_SHADER_CACHE=0 turns the disk layer off; the in-memory cache is unchanged.
+// -----------------------------------------------------------------------------
+static unsigned int g_disk_cache_hits = 0;
+static unsigned int g_disk_cache_misses = 0;
+
+static uint64_t Disk_Cache_Hash(bool vertex_stage, const std::string &hlsl)
+{
+	uint64_t hash = 14695981039346656037ull;
+	hash = (hash ^ (uint64_t)(vertex_stage ? 'v' : 'p')) * 1099511628211ull;
+	const uint64_t size = (uint64_t)hlsl.size();
+	for (int i = 0; i < 8; ++i) {
+		hash = (hash ^ ((size >> (i * 8)) & 0xffu)) * 1099511628211ull;
+	}
+	for (size_t i = 0; i < hlsl.size(); ++i) {
+		hash = (hash ^ (uint64_t)(unsigned char)hlsl[i]) * 1099511628211ull;
+	}
+	return hash;
+}
+
+static const std::string &Disk_Cache_Dir()
+{
+	static const std::string dir = []() -> std::string {
+		const char *off = getenv("ZH_SHADER_CACHE");
+		if (off != NULL && off[0] == '0') {
+			return std::string();
+		}
+		const char *base = getenv("ZH_USER_DATA_DIR");
+		if (base == NULL || base[0] == '\0') {
+			return std::string();
+		}
+		const std::string made = std::string(base) + "/shadercache";
+		mkdir(base, 0777);
+		mkdir(made.c_str(), 0777);
+		return made;
+	}();
+	return dir;
+}
+
+static std::string Disk_Cache_Path(bool vertex_stage, const std::string &hlsl)
+{
+	const std::string &dir = Disk_Cache_Dir();
+	if (dir.empty()) {
+		return std::string();
+	}
+	char name[32];
+	snprintf(name, sizeof(name), "%016llx.spv", (unsigned long long)Disk_Cache_Hash(vertex_stage, hlsl));
+	return dir + "/" + name;
+}
+
+static bool Disk_Cache_Load(const std::string &path, std::vector<unsigned char> &spirv)
+{
+	if (path.empty()) {
+		return false;
+	}
+	FILE *file = fopen(path.c_str(), "rb");
+	if (file == NULL) {
+		++g_disk_cache_misses;
+		return false;
+	}
+	fseek(file, 0, SEEK_END);
+	const long size = ftell(file);
+	fseek(file, 0, SEEK_SET);
+	bool ok = size >= 20 && (size % 4) == 0;
+	if (ok) {
+		spirv.resize((size_t)size);
+		ok = fread(&spirv[0], 1, (size_t)size, file) == (size_t)size;
+	}
+	fclose(file);
+	if (ok) {
+		uint32_t magic = 0;
+		memcpy(&magic, &spirv[0], sizeof(magic));
+		ok = magic == 0x07230203u;
+	}
+	if (!ok) {
+		spirv.clear();
+		++g_disk_cache_misses;
+		return false;
+	}
+	++g_disk_cache_hits;
+	static bool said = false;
+	if (!said) {
+		said = true;
+		fprintf(stderr, "SdlProgramCache: persistent shader cache active at %s\n", Disk_Cache_Dir().c_str());
+	}
+	return true;
+}
+
+static void Disk_Cache_Store(const std::string &path, const std::vector<unsigned char> &spirv)
+{
+	if (path.empty() || spirv.empty()) {
+		return;
+	}
+	const std::string temp = path + ".tmp";
+	FILE *file = fopen(temp.c_str(), "wb");
+	if (file == NULL) {
+		return;
+	}
+	const bool ok = fwrite(&spirv[0], 1, spirv.size(), file) == spirv.size();
+	fclose(file);
+	if (ok) {
+		rename(temp.c_str(), path.c_str());
+	}
+	else {
+		remove(temp.c_str());
+	}
+}
