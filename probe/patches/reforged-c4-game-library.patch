 #include "posixpath.h"
 
+// GeneralsX @zh-c4-crumb 19/11/2026: the frame-entry patch makes
+// SdlGpuFrame::Create report its stages through zh_probe_crumb, whose
+// definition lives in the selfcheck's entry TU. The game library links
+// the same posixd3d9 archive but not that TU, so the game's entry TU
+// provides the symbol here: crumbs go to stderr (logcat under SDL).
+extern "C" void zh_probe_crumb(const char *stage)
+{
+	fprintf(stderr, "[crumb] %s\n", stage ? stage : "(null)");
+	fflush(stderr);
+}
