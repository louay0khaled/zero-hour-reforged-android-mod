+// A language pack may carry its own labels; otherwise the text language's short names.
+static UnicodeString armyButtonLabel(Int index)
+{
+	static const char *const kLabelKeys[ARMY_BUTTON_COUNT] = {
+		"GUI:ArmyScreenShort", "GUI:ArmyMapShort", "GUI:ArmyPlanesShort", "GUI:ArmyHelicoptersShort", "GUI:ArmyGround" };
+	if (TheGameText) {
+		Bool exists = FALSE;
+		UnicodeString label = TheGameText->fetch(kLabelKeys[index], &exists);
+		if (exists) {
+			return label;
+		}
+	}
+	struct Labels { const char *language; const WideChar *text[ARMY_BUTTON_COUNT]; };
+	static const Labels kLabels[] = {
+		{ "english", { u"Screen", u"Map", u"Planes", u"Helis", u"Ground" } },
+		{ "russian", { u"Экран", u"Карта", u"Самолёты", u"Вертол.", u"Наземные" } },
+		{ "ukrainian", { u"Екран", u"Карта", u"Літаки", u"Гелікоп.", u"Наземні" } },
+		{ "interslavic", { u"Ekran", u"Mapa", u"Aviony", u"Helikop.", u"Zemja" } },
+		{ "arabic", { u"الشاشة", u"الخريطة", u"طائرات", u"مروحيات", u"برية" } },
+		{ "brazilian", { u"Tela", u"Mapa", u"Aviões", u"Helicóp.", u"Terrest." } },
+		{ "chinese", { u"屏幕", u"全图", u"战机", u"直升机", u"地面" } },
+		{ "french", { u"Écran", u"Carte", u"Avions", u"Hélicos", u"Sol" } },
+		{ "german", { u"Bild", u"Karte", u"Flieger", u"Helis", u"Boden" } },
+		{ "korean", { u"화면", u"지도", u"전투기", u"헬기", u"지상군" } },
+		{ "persian", { u"صفحه", u"نقشه", u"هواپیما", u"بالگرد", u"زمینی" } },
+		{ "polish", { u"Ekran", u"Mapa", u"Samoloty", u"Śmigłow.", u"Lądowe" } },
+		{ "spanish", { u"Pantalla", u"Mapa", u"Aviones", u"Helicóp.", u"Tierra" } },
+	};
+	const char *pack = getenv("GENERALSX_TEXT_LANGUAGE");
+	AsciiString language = (pack != nullptr && pack[0] != '\0') ? AsciiString(pack) : GetRegistryLanguage();
+	language.toLower();
+	for (Int i = 0; i < (Int)(sizeof(kLabels) / sizeof(kLabels[0])); ++i) {
+		if (language.compare(kLabels[i].language) == 0) {
+			return UnicodeString(kLabels[i].text[index]);
+		}
+	}
+	return UnicodeString(kLabels[0].text[index]);
+}
