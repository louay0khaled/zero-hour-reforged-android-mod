+/*
+** SdlTouch.cpp -- Reforged Android C5 touch graft.
+**
+** The native touch layer ported from the MYSOREZ/GeneralsX Android port
+** (SDL3GameEngine.cpp's touch machine + TouchInput), adapted to this fork:
+** display-share coordinate mapping (no pillarbox), the InGameUI aim point
+** as the single preview feed (no touch cursor object), the fork's
+** LookAtTranslator expressions for the scroll latch, and no pointer modes.
+** See the wave-8 record (C5, sections 246-255b) for the port catalog.
+*/
+
+#include "SdlDevice/GameClient/SdlTouch.h"
+#include "SdlDevice/GameClient/TouchInput.h"
+
+#include "Common/GameType.h"
+#include "Common/GlobalData.h"
