+// The weak-GPU test behind both shadow savings (S1 coarse receivers, S3 sun-map cap):
+// the SDL driver string names the part ("Mali-G52 MC2" on the reference phone), and a
+// tile-based Mali is where the fifty-tap receiver and the 2048 map hurt most. Asked
+// once, answered for the process; the driver string is logged either way.
+//
+// The test is MODEL-aware, not family-wide (owner, 2026-11-20): Mali spans a decade of
+// parts, and the flagship Mali/Immortalis GPUs in Dimensity 8400-class SoCs and above
+// must never be capped by a rule written for the entry parts. Weak means a named entry
+// part only -- Mali-Txxx (pre-G) or G31/G51/G52/G57/G310. Any other Mali (G68 and up,
+// every G6xx/G7xx, Immortalis G9xx) and any Mali whose model cannot be parsed keep
+// full quality: the gate exists to help parts known to be weak, and an unknown part
+// is never capped on a guess.
+bool WeakGpu(IDirect3DDevice9 *d) {
+    static int weak = -1;
+    if (weak < 0) {
+        weak = 0;
+        PosixDevice9 *dev = d ? static_cast<PosixDevice9*>(d) : nullptr;
+        if (dev && dev->Get_Gpu() && dev->Get_Gpu()->Device()) {
+            const char *driver = SDL_GetGPUDeviceDriver(dev->Get_Gpu()->Device());
+            if (driver) {
+                if (const char *mali = std::strstr(driver, "Mali-")) {
+                    const char series = mali[5];
+                    const int model = std::atoi(mali + 6);
+                    if (series == 'T') weak = 1;
+                    else if (series == 'G' && (model == 31 || model == 51 || model == 52 || model == 57 || model == 310)) weak = 1;
+                }
+            }
+            std::fprintf(stderr, "[shadow] gpu driver '%s' weak=%d\n", driver ? driver : "?", weak);
+        }
+    }
+    return weak == 1;
+}
