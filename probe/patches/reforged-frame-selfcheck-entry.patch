diff --git a/GeneralsMD/Code/Tests/frame_selfcheck_main.cpp b/GeneralsMD/Code/Tests/frame_selfcheck_main.cpp
new file mode 100644
index 00000000..517ac713
--- /dev/null
+++ b/GeneralsMD/Code/Tests/frame_selfcheck_main.cpp
@@ -0,0 +1,236 @@
+/*
+**	Entry point + crash instrumentation for sdl_gpu_frame_selfcheck on
+**	Android — added by the Android probe harness patch (Stage C, slice
+**	C2; this file is not part of upstream). Same licence as the tree:
+**	GNU GPL v3 or later.
+**
+**	Why this file exists: on Android SDL3 is built with
+**	SDL_MAIN_NEEDED, so SDL_Init refuses to run until SDL's own entry
+**	trampoline has marked the process main-ready — in SDL's Android
+**	model that happens inside SDLActivity's JNI initialisation
+**	(SDL_android.c, checkJNIReady -> SDL_SetMainReady), before
+**	nativeRunMain calls the application's SDL_main. The selfcheck is
+**	an offscreen test that the probe harness runs as a bare child
+**	process: no activity, no JNI, no trampoline, so its plain main()
+**	reached SDL_Init with the flag clear and the run ended as a
+**	"SKIP" (exit 77) before any GPU code ran — an entry-model
+**	verdict masquerading as a device verdict (plan section 8).
+**
+**	The fix keeps the process model and gives the payload the one
+**	act of the trampoline it actually needs: the test TU is compiled
+**	with its main renamed to sdl_gpu_frame_selfcheck_body() (the
+**	SDL_main.h trick, scoped to that one TU by the CMake wiring in
+**	this patch), and this TU provides the process entry: mark SDL
+**	ready in this binary's own statically linked SDL instance, then
+**	run the body. The offscreen video driver and the GPU device
+**	need no JNI, no window and no surface.
+**
+**	Crash instrumentation (plan section 9): the first fixed build
+**	reached real initialisation on the owner's phone and died by
+**	SIGSEGV having printed nothing at all. That silence localised
+**	almost nothing: the payload's stdout is a pipe, hence
+**	block-buffered, and a signal death never flushes it — every
+**	printf the body made before dying was lost with the buffer. So
+**	this TU also carries:
+**
+**	  - zh_probe_crumb(stage): breadcrumbs written with write() to
+**	    stderr — unbuffered, and the harness tees the child's stderr
+**	    into probe-log.txt live. The test TU and SdlGpuFrame::Create
+**	    call it between their stages (ZH_FRAME_PROBE_CRUMBS, set by
+**	    the same CMake wiring), so one device run names the last
+**	    stage reached.
+**	  - a crash handler in the C0 shim's shape — async-signal-safe
+**	    write()s only — that appends the signal, the fault address
+**	    and the last breadcrumb, plus a backtrace when the runtime
+**	    provides one: bionic exports backtrace() and
+**	    backtrace_symbols_fd() from API 33 only, and the probe
+**	    builds at API 28 where the headers do not declare them,
+**	    so they are resolved with dlsym and warmed up once here in
+**	    normal context; the handler ever only calls the pre-resolved
+**	    pointers. It then restores the default disposition and
+**	    re-raises, so the process dies exactly as it would have
+**	    without us and the harness still reports 128+signal.
+**
+**	The instrumentation stays until the renderer PASS lands
+**	(section 9), then it can be trimmed.
+*/
+
+/* SDL_MAIN_HANDLED: this TU provides its own main() and calls
+** SDL_SetMainReady() itself — the arrangement SDL_main.h's own
+** documentation prescribes for exactly this case. (SDL_SetMainReady
+** is declared by SDL_main.h; SDL.h does not declare it.) */
+#define SDL_MAIN_HANDLED
+#include <SDL3/SDL_main.h>
+
+#include <dlfcn.h>
+#include <signal.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+int sdl_gpu_frame_selfcheck_body();
+
+/* ------------------------------------------------------------------ */
+/* Breadcrumbs                                                         */
+/* ------------------------------------------------------------------ */
+
+static const char *volatile g_zh_last_crumb = "entry-not-reached";
+
+static void zh_write2(const char *s)
+{
+	if (s == NULL) {
+		return;
+	}
+	size_t len = 0;
+	while (s[len] != '\0') {
+		++len;
+	}
+	size_t off = 0;
+	while (off < len) {
+		ssize_t w = write(STDERR_FILENO, s + off, len - off);
+		if (w <= 0) {
+			break;
+		}
+		off += static_cast<size_t>(w);
+	}
+}
+
+/* Called between the payload's stages by the test TU and by
+** SdlGpuFrame::Create (both under ZH_FRAME_PROBE_CRUMBS). Stage names
+** are string literals; the last one is kept for the crash handler. */
+extern "C" void zh_probe_crumb(const char *stage)
+{
+	if (stage == NULL) {
+		stage = "(null)";
+	}
+	g_zh_last_crumb = stage;
+	zh_write2("[crumb] ");
+	zh_write2(stage);
+	zh_write2("\n");
+	/* write() to a pipe is unbuffered and the harness drains it
+	   concurrently: the stage is in probe-log.txt the moment it is
+	   written, with no stdio buffer in between to lose. */
+}
+
+/* ------------------------------------------------------------------ */
+/* Crash forensics (async-signal-safe writes only)                     */
+/* ------------------------------------------------------------------ */
+
+typedef int (*zh_backtrace_fn)(void **buffer, int size);
+typedef void (*zh_backtrace_symbols_fd_fn)(void *const *buffer, int size, int fd);
+static zh_backtrace_fn g_zh_backtrace = NULL;
+static zh_backtrace_symbols_fd_fn g_zh_backtrace_symbols_fd = NULL;
+static void *g_zh_warmup_frames[8];
+
+static void zh_buf_append(char *&p, const char *s)
+{
+	while (*s) {
+		*p++ = *s++;
+	}
+}
+
+static void zh_buf_append_uint(char *&p, unsigned long v)
+{
+	char tmp[24];
+	int i = 0;
+	do {
+		tmp[i++] = static_cast<char>('0' + (v % 10));
+		v /= 10;
+	} while (v != 0);
+	while (i > 0) {
+		*p++ = tmp[--i];
+	}
+}
+
+static void zh_buf_append_hex(char *&p, unsigned long v)
+{
+	*p++ = '0';
+	*p++ = 'x';
+	char tmp[16];
+	int i = 0;
+	do {
+		unsigned long d = v & 0xFul;
+		tmp[i++] = static_cast<char>(d < 10 ? '0' + d : 'a' + (d - 10));
+		v >>= 4;
+	} while (v != 0);
+	while (i > 0) {
+		*p++ = tmp[--i];
+	}
+}
+
+static void zh_crash_handler(int sig, siginfo_t *info, void * /*context*/)
+{
+	char buf[512];
+	char *p = buf;
+	zh_buf_append(p, "[crumb] CRASH: signal ");
+	zh_buf_append_uint(p, static_cast<unsigned long>(sig));
+	zh_buf_append(p, " at address ");
+	zh_buf_append_hex(p, static_cast<unsigned long>(
+		reinterpret_cast<uintptr_t>(info ? info->si_addr : NULL)));
+	zh_buf_append(p, "; last stage: ");
+	zh_buf_append(p, g_zh_last_crumb ? g_zh_last_crumb : "(none)");
+	zh_buf_append(p, "\n");
+	ssize_t r = write(STDERR_FILENO, buf, static_cast<size_t>(p - buf));
+	(void)r;
+	if (g_zh_backtrace != NULL && g_zh_backtrace_symbols_fd != NULL) {
+		void *frames[24];
+		int n = g_zh_backtrace(frames, 24);
+		if (n > 0) {
+			zh_write2("[crumb] backtrace follows (the top frames are the "
+			          "handler itself):\n");
+			g_zh_backtrace_symbols_fd(frames, n, STDERR_FILENO);
+		}
+	}
+	signal(sig, SIG_DFL);
+	raise(sig);
+	_exit(128 + sig);
+}
+
+static void zh_install_crash_handler()
+{
+	/* Resolve + warm up in normal context ONLY. If the runtime lacks
+	   the functions (an API < 33 device), both pointers stay NULL and
+	   the handler writes its CRASH line without frames. */
+	g_zh_backtrace = reinterpret_cast<zh_backtrace_fn>(
+		dlsym(RTLD_DEFAULT, "backtrace"));
+	g_zh_backtrace_symbols_fd = reinterpret_cast<zh_backtrace_symbols_fd_fn>(
+		dlsym(RTLD_DEFAULT, "backtrace_symbols_fd"));
+	if (g_zh_backtrace != NULL && g_zh_backtrace_symbols_fd != NULL) {
+		/* Warm-up: any lazy unwinder setup happens here, never inside
+		   the signal handler. A non-positive return means unusable. */
+		if (g_zh_backtrace(g_zh_warmup_frames, 8) <= 0) {
+			g_zh_backtrace = NULL;
+			g_zh_backtrace_symbols_fd = NULL;
+		}
+	} else {
+		g_zh_backtrace = NULL;
+		g_zh_backtrace_symbols_fd = NULL;
+	}
+	struct sigaction sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = zh_crash_handler;
+	sigemptyset(&sa.sa_mask);
+	sa.sa_flags = SA_SIGINFO;
+	const int sigs[] = {SIGSEGV, SIGABRT, SIGBUS, SIGFPE, SIGILL};
+	for (int s : sigs) {
+		sigaction(s, &sa, NULL);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Entry                                                               */
+/* ------------------------------------------------------------------ */
+
+int main(int argc, char *argv[])
+{
+	(void)argc;
+	(void)argv;
+	zh_install_crash_handler();
+	zh_probe_crumb("entry");
+	SDL_SetMainReady();
+	zh_probe_crumb("main-ready");
+	int rc = sdl_gpu_frame_selfcheck_body();
+	zh_probe_crumb("body-returned");
+	return rc;
+}
