<?xml version="1.0" encoding="utf-8"?>
<!-- Stage C, slice C0: throwaway GPU capability probe. The package id is
     deliberately separate so the probe can never collide with the game apps
     (com.generalsx.zerohour, com.louay.zerohour.reforged). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.louay.zerohour.gpuprobe"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <application
        android:label="Reforged GPU Probe"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".ProbeMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout|smallestScreenSize|density|layoutDirection|locale|fontScale|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

        <!-- Stage C2 route B: the frame selfcheck's own SDLActivity
             (subclass naming its library), in a SEPARATE PROCESS so
             the payload's statically linked SDL never shares a
             process with the harness's shared SDL. The launcher
             chains it after the harness activity and merges its
             frame-result.txt into the verdict. -->
        <activity
            android:name=".FrameCheckActivity"
            android:exported="false"
            android:process=":framecheck"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout|smallestScreenSize|density|layoutDirection|locale|fontScale|uiMode"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
