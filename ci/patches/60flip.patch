--- a/GeneralsMD/Code/GameEngine/Source/GameLogic/AI/AIStates.cpp
+++ b/GeneralsMD/Code/GameEngine/Source/GameLogic/AI/AIStates.cpp
@@ -5207,6 +5207,55 @@
  * Fire the owner's weapon once and exit.
  */
 
+//-------------------------------------------------------------------------------------------------
+/**
+ * GeneralsX @feature Zero Hour Reforged 11/11/2026 Wave 6 slice 6f -- upstream
+ * Reforged's retail fire-cycle hold, the state-machine half of the
+ * conversion's weapon correction (the Weapon.cpp algebra half landed in 6c).
+ *
+ * After a shot this state hands back to aiming, which hands back here a frame
+ * later, and a weapon not ready yet goes round again: a shot can only come on
+ * every second frame after the last. Retail ran that loop at 30 Hz, so its
+ * weapons fired on a grid of two retail frames, and a 100 msec Quad Cannon
+ * (3 frames) fired every 4, 0.133 s. At 60 steps the same loop is a grid of
+ * two logic frames, half as coarse, and the gun would fire every 0.100 s.
+ * Holding the next shot to the next point of the retail grid puts every
+ * weapon this state fires back on its retail frames. Weapons fired elsewhere
+ * (FireWeaponUpdate, a point defense laser) never had the loop and keep their
+ * delays as they are.
+ *
+ * At the retail rate the hold is NOT an identity (an odd wait of 3 would
+ * become 4), so the standard build returns at once -- its stream stays
+ * bit-exact, and the hold acts only where it has meaning, at ratio 2.
+ */
+static void holdToRetailFireCycle( Object *obj, const Weapon *fired )
+{
+	if( LOGICFRAMES_PER_RETAIL_FRAME == 1 )
+		return;
+
+	const UnsignedInt now = TheGameLogic->getFrame();
+	if( fired->getLastShotFrame() != now )
+		return;
+
+	// every slot that fired this frame (linked turrets fire them all), and every slot a shared reload
+	// stamped; rounding a frame already on the grid leaves it there, so a slot met twice is no matter
+	const UnsignedInt CYCLE = 2 * LOGICFRAMES_PER_RETAIL_FRAME;
+	const Bool shared = obj->isReloadTimeShared();
+	for( Int slot = PRIMARY_WEAPON; slot < WEAPONSLOT_COUNT; ++slot )
+	{
+		Weapon *each = obj->getWeaponInWeaponSlot( (WeaponSlotType)slot );
+		if( !each || ( !shared && each->getLastShotFrame() != now ) )
+			continue;
+		const UnsignedInt next = each->getPossibleNextShotFrame();
+		// empty for good: privateFireWeapon parks it at 0x7fffffff
+		if( next >= 0x7fffffff )
+			continue;
+		const UnsignedInt wait = next > now ? next - now : 0;
+		each->setPossibleNextShotFrame( now + max( CYCLE, ( wait + CYCLE - 1 ) / CYCLE * CYCLE ) );
+	}
+}
