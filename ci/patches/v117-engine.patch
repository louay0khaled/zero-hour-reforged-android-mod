diff --git a/Core/Libraries/Include/GXTestRecorder.h b/Core/Libraries/Include/GXTestRecorder.h
new file mode 100644
index 0000000..fa1259d
--- /dev/null
+++ b/Core/Libraries/Include/GXTestRecorder.h
@@ -0,0 +1,82 @@
+// GeneralsX @feature Zero Hour Reforged 18/11/2026 (v1.17): the owner's
+// independent test recorder. Deliberately separate from the host's GX-PERF
+// system: the launcher's Tests page switch creates the "gx_testrec.txt"
+// marker in the app's files dir (the same mechanism as the GXTrace
+// markers), and while it exists the engine appends plain-number lines to
+// "test-rec.txt" in the same dir and mirrors them to stderr with the
+// [GX-TESTREC] tag (stderr lands in generals-stderr.log, which the
+// launcher's log export always carries).
+//
+// Recorded: match start, the engine CRC at frames 100/200/300 (the LAN
+// desync discriminator: two phones with the same seed must print the same
+// three numbers), a per-minute RSS line, and the LAN lobby events (game
+// announce / join request / join accept / game start / match-start seed).
+//
+// Read-only instrumentation: nothing here ever touches game state, and the
+// marker check is cached after the first call, so a disabled recorder
+// costs one bool test per call site.
+#pragma once
+
+#include <cstdio>
+#include <cstring>
+#include <cstdarg>
+
+namespace GXTestRec
+{
+
+inline bool enabled()
+{
+	static int s_state = -1;
+	if (s_state < 0)
+	{
+		s_state = 0;
+		FILE *marker = fopen("gx_testrec.txt", "r");
+		if (marker != nullptr)
+		{
+			fclose(marker);
+			s_state = 1;
+		}
+	}
+	return s_state == 1;
+}
+
+inline void logLine(const char *fmt, ...)
+{
+	if (!enabled())
+		return;
+	char buf[512];
+	va_list args;
+	va_start(args, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, args);
+	va_end(args);
+	fprintf(stderr, "[GX-TESTREC] %s\n", buf);
+	fflush(stderr);
+	FILE *f = fopen("test-rec.txt", "a");
+	if (f != nullptr)
+	{
+		fprintf(f, "%s\n", buf);
+		fclose(f);
+	}
+}
+
+// Current resident set size in kB (Android/Linux), -1 when unavailable.
+inline long rssKb()
+{
+	FILE *f = fopen("/proc/self/status", "r");
+	if (f == nullptr)
+		return -1;
+	char line[256];
+	long kb = -1;
+	while (fgets(line, sizeof(line), f) != nullptr)
+	{
+		if (strncmp(line, "VmRSS:", 6) == 0)
+		{
+			sscanf(line + 6, "%ld", &kb);
+			break;
+		}
+	}
+	fclose(f);
+	return kb;
+}
+
+} // namespace GXTestRec
