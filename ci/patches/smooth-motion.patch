+// GeneralsX @feature Zero Hour Reforged 11/11/2026 Smooth motion tick readout, ported from the
+// Reforged engine: when the pass's last logic tick was due, and the tick's length, so the renderer
+// can blend between the last two logic states (W3DSmoothMotion.h).  Readout only -- every pacing
+// decision in this file is untouched.  The fine clock is the steady clock in microseconds, the
+// same clock the catch-up code below already uses.
+static Int64 s_smoothLastTickDueTicks = 0;
+static Real s_smoothMsPerLogicTick = 0.0f;
+
+static Int64 smoothMotionNowTicks()
+{
+	return std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+Real GameEngine_tickFraction( Int64 now, Int64 due, Real msPerTick, Int64 ticksPerSecond )
+{
+	if (msPerTick <= 0.0f || ticksPerSecond <= 0)
+		return 1.0f;
+	const Real fraction = (Real)((double)(now - due) * 1000.0 / (double)ticksPerSecond) / msPerTick;
+	return fraction < 0.0f ? 0.0f : (fraction > 1.0f ? 1.0f : fraction);
+}
+
+Real GameEngine_logicTickFraction( void )
+{
+	return GameEngine_tickFraction( smoothMotionNowTicks(), s_smoothLastTickDueTicks, s_smoothMsPerLogicTick, 1000000 );
+}
+
+/* Stamp the tick that just ran: its length from the pacing state (a network game's frame rate,
+   the logic time scale, or the render period the logic is bound to), and its due moment -- the
+   stamp is taken now, less the accumulator debt the decoupled pacer still holds, so the fraction
+   runs from when the tick was due, not from when it happened to execute.  Callers whose ticks
+   were due at once (the catch-up steps) pass no debt. */
+static void noteSmoothLogicTick( Real accumulatorDebtSeconds )
+{
+	Real msPerTick = 0.0f;
+	if (TheNetwork != nullptr)
+	{
+		// the frame that just ran may have ended the match and taken the network with it
+		const UnsignedInt rate = TheNetwork->getFrameRate();
+		msPerTick = rate > 0 ? 1000.0f / (Real)rate : 0.0f;
+	}
+	else if (TheFramePacer->isLogicTimeScaleEnabled())
+	{
+		const Int fps = TheFramePacer->getLogicTimeScaleFps();
+		msPerTick = fps > 0 ? 1000.0f / (Real)fps : 0.0f;
+	}
+	else if (TheFramePacer->isActualFramesPerSecondLimitEnabled())
+	{
+		// logic bound to the render update (the original behavior): the tick length is the render period
+		const Int limit = TheFramePacer->getActualFramesPerSecondLimit();
+		msPerTick = limit > 0 ? 1000.0f / (Real)limit : 0.0f;
+	}
+	else if (TheFramePacer->getUpdateTime() > 0.0f)
+	{
+		msPerTick = TheFramePacer->getUpdateTime() * 1000.0f;
+	}
+	s_smoothMsPerLogicTick = msPerTick;
+	s_smoothLastTickDueTicks = smoothMotionNowTicks() - (Int64)(accumulatorDebtSeconds * 1000000.0);
+}
