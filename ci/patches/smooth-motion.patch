+//=============================================================================
+// Smooth motion (W3DSmoothMotion.h), ported from the Reforged engine.  Three steps around the
+// scene's render, and only the picture:
+//   smoothMotionBegin    before updateViews: the blend's alpha, and on a new tick each drawable's
+//                        position (the camera's lock follows the blended one)
+//   smoothMotionApply    after the particle update, before anything renders: on a new tick each
+//                        model's transform is captured, then every model is shown blended
+//   smoothMotionRestore  after the render loop: the logic transforms go back before picking and
+//                        the logic
+// A logic tick reads live bones (ParticleUplinkCannonUpdate), and ticks run outside draw() in
+// this engine, so a tick never runs beside a blend: restore at the end of draw() has always put
+// the logic transforms back before the next tick can run.
+//=============================================================================
+bool TheSmoothMotionActive = false;
+float TheSmoothMotionAlpha = 1.0f;
+static UnsignedInt s_smoothPositionFrame = 0xFFFFFFFFu;
+static UnsignedInt s_smoothModelFrame = 0xFFFFFFFFu;
+static Bool s_smoothApplied = FALSE;
+static Bool s_smoothBehind = FALSE;		// this picture is a whole tick or more behind: nothing captured or blended
+
+/* Smooth motion's default: a blend only when the display refreshes faster than the logic ticks.
+   At the logic's own rate every refresh shows a new tick already, and the blend would only draw
+   each one a tick late.  The host has no adapter display-mode query on this path, so the check
+   reads the pacing state instead: a network game's frame rate, or the logic time scale, against
+   the render limit (or the measured update rate when rendering is uncapped).  Logic bound to the
+   render update (no time scale, no network) ticks once per picture by construction, so it never
+   outpaces.  Asked every picture, so a frame-rate change at runtime takes effect at once. */
+static Bool displayOutpacesLogic()
+{
+	Int logicFps;
+	if (TheNetwork != NULL)
+		logicFps = TheNetwork->getFrameRate();
+	else if (TheFramePacer->isLogicTimeScaleEnabled())
+		logicFps = TheFramePacer->getLogicTimeScaleFps();
+	else
+		return FALSE;
+	if (logicFps <= 0)
+		return FALSE;
+	if (TheFramePacer->isActualFramesPerSecondLimitEnabled())
+		return TheFramePacer->getActualFramesPerSecondLimit() > logicFps;
+	return TheFramePacer->getUpdateFps() > (Real)logicFps;
+}
+
+static void smoothMotionBegin()
+{
+	// on a display faster than the logic, unless -nosmoothmotion says no
+	TheSmoothMotionActive = !TheGlobalData->m_headless
+		&& TheGlobalData->m_smoothMotion && (TheGlobalData->m_smoothMotionAnyDisplay || displayOutpacesLogic());
+	TheSmoothMotionAlpha = TheSmoothMotionActive ? GameEngine_logicTickFraction() : 1.0f;
+	// A picture a whole tick or more behind the battle shows every model at its logic transform, so it
+	// captures and blends nothing, and a game that has fallen behind pays nothing for the blend.  The next
+	// picture under a tick captures, late in its tick if need be (the transforms are still that tick's),
+	// and a capture after a tick it missed snaps.
+	s_smoothBehind = TheSmoothMotionAlpha >= 1.0f;
+	if (!TheSmoothMotionActive || s_smoothBehind)
+		return;
+	const UnsignedInt frame = TheGameClient->getFrame();
+	if (frame == s_smoothPositionFrame)
+		return;
+	s_smoothPositionFrame = frame;
+	for (Drawable *draw = TheGameClient->firstDrawable(); draw != NULL; draw = draw->getNextDrawable())
+		draw->smoothMotionCapturePosition(frame);
+}
+
+static void smoothMotionApply()
+{
+	if (!TheSmoothMotionActive)
+		return;
+	if (s_smoothBehind)
+		return;
+	const UnsignedInt frame = TheGameClient->getFrame();
+	const Bool newTick = frame != s_smoothModelFrame;
+	s_smoothModelFrame = frame;
+	for (Drawable *draw = TheGameClient->firstDrawable(); draw != NULL; draw = draw->getNextDrawable())
+	{
+		DrawModule **modules = draw->getDrawModules();
+		if (modules == NULL)
+			continue;
+		if (newTick)
+		{
+			const Bool marked = draw->isMotionDiscontinuous();
+			for (DrawModule **dm = modules; *dm; ++dm)
+				(*dm)->smoothMotionCapture(frame, marked);
+			draw->clearMotionDiscontinuity();
+		}
+		for (DrawModule **dm = modules; *dm; ++dm)
+			(*dm)->smoothMotionApply(TheSmoothMotionAlpha);
+	}
+	s_smoothApplied = TRUE;
+}
+
+static void smoothMotionRestore()
+{
+	if (!s_smoothApplied)
+		return;
+	s_smoothApplied = FALSE;
+	for (Drawable *draw = TheGameClient->firstDrawable(); draw != NULL; draw = draw->getNextDrawable())
+	{
+		DrawModule **modules = draw->getDrawModules();
+		if (modules == NULL)
+			continue;
+		for (DrawModule **dm = modules; *dm; ++dm)
+			(*dm)->smoothMotionRestore();
+	}
+}
