+//=============================================================================
+// GeneralsX @feature Zero Hour Reforged 11/11/2026 -lighting <classic|reforged>: the
+// LightingStyle option for one run, ported from the Reforged engine -- the before and after
+// of any picture of it.
+Int parseLightingStyle(char *args[], int num)
+{
+	if (TheWritableGlobalData && num > 1)
+	{
+		if (strcasecmp(args[1], "classic") == 0)
+			TheWritableGlobalData->m_lightingStyle = LIGHTING_STYLE_CLASSIC;
+		else if (strcasecmp(args[1], "reforged") == 0)
+			TheWritableGlobalData->m_lightingStyle = LIGHTING_STYLE_REFORGED;
+		else
+			DEBUG_LOG(("-lighting: '%s' is neither classic nor reforged, keeping the current style\n", args[1]));
+		return 2;
+	}
+	return 1;
+}
