diff --git a/scripts/build/android/package-android-zh.sh b/scripts/build/android/package-android-zh.sh
index 075ff87..ea3c5e5 100755
--- a/scripts/build/android/package-android-zh.sh
+++ b/scripts/build/android/package-android-zh.sh
@@ -38,15 +38,24 @@ DEFAULT_DRIVER_ASSETS="${ANDROID_DIR}/app/src/main/assets/default_driver"
 STAGING="${GX_ANDROID_STAGING:-${HOME}/GeneralsX/android-staging}"
 
 # --- 1. native libraries -----------------------------------------------------
+# GeneralsX @feature Zero Hour Reforged 13/11/2026 (v1.13; v1.16) The
+# host's own engines no longer ship. With GX_OMIT_HOST_ENGINES set,
+# libmain.so is still built -- the dependency staging further down
+# reads its build tree -- but it is NOT copied into the APK; the only
+# play engine packaged is the pure 60-steps one (GX_ENGINE_LIB below).
+if [[ -z "${GX_OMIT_HOST_ENGINES:-}" ]]; then
 GAME_LIB="$(find "${BUILD_DIR}" -name libmain.so -not -path "*/_deps/*" 2>/dev/null | head -1)"
 if [[ -z "${GAME_LIB}" ]]; then
     echo "ERROR: libmain.so not found — run ./scripts/build/android/build-android-zh.sh first."
     exit 1
 fi
+fi
 
 rm -rf "${JNILIBS}"
 mkdir -p "${JNILIBS}"
+if [[ -z "${GX_OMIT_HOST_ENGINES:-}" ]]; then
 cp "${GAME_LIB}" "${JNILIBS}/libmain.so"
+fi
 
 # GeneralsX @feature Android port 15/09/2026 Optional second engine build.
 #
@@ -64,11 +73,27 @@ if [[ -n "${GX_SECOND_GAME_LIB:-}" ]]; then
     echo "Packaging a second engine: libmain60.so ($(du -h "${GX_SECOND_GAME_LIB}" | cut -f1))"
 fi
 
+
+# GeneralsX @feature Zero Hour Reforged 17/11/2026 (v1.16) The one play
+# engine of this app: the pure 60-steps build of the stock tree
+# (REFORGED_60_STEPS=ON on pristine sources + the n60 patch set),
+# packaged as libmainz60.so. The launcher names it directly -- there
+# is no engine switch and no second engine. (v1.13-v1.15 shipped two
+# Reforged engines behind a pref switch; both are removed.)
+if [[ -n "${GX_ENGINE_LIB:-}" ]]; then
+    if [[ ! -f "${GX_ENGINE_LIB}" ]]; then
+        echo "ERROR: GX_ENGINE_LIB points at a file that does not exist: ${GX_ENGINE_LIB}"
+        exit 1
+    fi
+    cp "${GX_ENGINE_LIB}" "${JNILIBS}/libmainz60.so"
+    echo "Packaging the pure 60-steps engine: libmainz60.so ($(du -h "${GX_ENGINE_LIB}" | cut -f1))"
+fi
+
 # GeneralsX @feature Android port 04/10/2026 The base game, Command & Conquer Generals, in the
 # same APK: libgenerals.so (30 Hz) and, from build-dual-hz.sh, libgenerals60.so. The launcher
 # loads one of the four (GeneralsZHActivity.getLibraries()).
 BASE_GAME_LIB="$(find "${BUILD_DIR}" -name libgenerals.so -not -path "*/_deps/*" 2>/dev/null | head -1)"
-if [[ -n "${BASE_GAME_LIB}" ]]; then
+if [[ -z "${GX_OMIT_HOST_ENGINES:-}" && -n "${BASE_GAME_LIB}" ]]; then
     cp "${BASE_GAME_LIB}" "${JNILIBS}/libgenerals.so"
     echo "Packaging the base game: libgenerals.so ($(du -h "${BASE_GAME_LIB}" | cut -f1))"
 fi
@@ -367,10 +392,14 @@ if [[ -n "${GX_ANDROID_VERSION_NAME:-}" ]]; then
     GRADLE_VERSION_ARG="${GRADLE_VERSION_ARG} -PandroidVersionName=${GX_ANDROID_VERSION_NAME}"
 fi
 
-echo "==> ${GRADLE_CMD} assembleDebug ${GRADLE_VERSION_ARG}"
-"${GRADLE_CMD}" assembleDebug ${GRADLE_VERSION_ARG}
+echo "==> ${GRADLE_CMD} ${GX_GRADLE_TASK:-assembleDebug} ${GRADLE_VERSION_ARG}"
+"${GRADLE_CMD}" ${GX_GRADLE_TASK:-assembleDebug} ${GRADLE_VERSION_ARG}
 
-APK="${ANDROID_DIR}/app/build/outputs/apk/debug/app-debug.apk"
+if [[ "${GX_GRADLE_TASK:-assembleDebug}" == "assembleRelease" ]]; then
+    APK="${ANDROID_DIR}/app/build/outputs/apk/release/app-release.apk"
+else
+    APK="${ANDROID_DIR}/app/build/outputs/apk/debug/app-debug.apk"
+fi
 if [[ ! -f "${APK}" ]]; then
     echo "ERROR: expected APK not found at ${APK}"
     exit 1
