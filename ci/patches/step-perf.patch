+//-------------------------------------------------------------------------------------------------
+// GeneralsX @performance Zero Hour Reforged 12/11/2026 (M2 WS1) -- could the affiliation filter
+// in doTeamUseCommandButtonOnNearestObjectType (enemies, neutral, or our own, from `me`)
+// accept an object of this type held by anyone? The filter accepts an object when its team's
+// relationship to `me` is ENEMIES or NEUTRAL, or when its controlling player is `me`
+// (PartitionFilterPlayerAffiliation::allow). With no team-keyed override a relationship to a
+// team depends only on the team's player, and that player's default team answers for all of
+// its teams (Player::getRelationship), so one question per player settles it; any doubt
+// answers TRUE and the search runs exactly as before.
+static Bool enemyNeutralOrSelfHolds( const Player *me, const ThingTemplate *type )
+{
+	const Bool perTeam = me->hasTeamRelationships();
+	for (Int i = 0; i < ThePlayerList->getPlayerCount(); ++i)
+	{
+		const Player *holder = ThePlayerList->getNthPlayer(i);
+		if (!holder->hasTemplateMember(type))
+			continue;
+		if (perTeam || holder == me || holder->getDefaultTeam()->getControllingPlayer() != holder
+				|| me->getRelationship(holder->getDefaultTeam()) != ALLIES)
+			return TRUE;
+	}
+	return FALSE;
+}
