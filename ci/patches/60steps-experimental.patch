+//-------------------------------------------------------------------------------------------------
+// GeneralsX @feature Zero Hour Reforged 11/11/2026 EXPERIMENTAL (M2 wave 6, slice 6a): the
+// retail-frame INI hooks of Reforged's 60-steps conversion, ported from the Reforged engine.
+// Each parses exactly like its plain counterpart, then converts the value from the retail
+// 30 steps/s the data was written for (GameCommon.h); at the shipped rate the conversion is
+// the identity. No field table uses these yet.
+//-------------------------------------------------------------------------------------------------
+void INI::parseRetailFramesInt( INI* ini, void * /*instance*/, void *store, const void* /*userData*/ )
+{
+	const char *token = ini->getNextToken();
+	*(Int *)store = ConvertRetailFrames(scanInt(token));
+
+}
+
+void INI::parseRetailFramesUnsignedInt( INI* ini, void * /*instance*/, void *store, const void* /*userData*/ )
+{
+	const char *token = ini->getNextToken();
+	*(UnsignedInt *)store = ConvertRetailFrames(scanUnsignedInt(token));
+
+}
+
+void INI::parseRetailFramesReal( INI* ini, void * /*instance*/, void *store, const void* /*userData*/ )
+{
+	const char *token = ini->getNextToken();
+	*(Real *)store = ConvertRetailFrames(scanReal(token));
+
+}
+
+void INI::parseRetailPerFrameReal( INI* ini, void * /*instance*/, void *store, const void* /*userData*/ )
+{
+	const char *token = ini->getNextToken();
+	*(Real *)store = ConvertRetailPerFrameRate(scanReal(token));
+
+}
+
+void INI::parseRetailPerFrameFactorReal( INI* ini, void * /*instance*/, void *store, const void* /*userData*/ )
+{
+	const char *token = ini->getNextToken();
+	*(Real *)store = ConvertRetailPerFrameFactor(scanReal(token));
+
+}
+
