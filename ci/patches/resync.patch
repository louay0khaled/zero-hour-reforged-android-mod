+// ------------------------------------------------------------------------------------------------
+// LAN resync (WiFi Play Pro Layer 2) -- GeneralsX @feature Reforged 14/11/2026
+//
+// Protocol summary lives in GameLogic.h at the ResyncState declaration. In short:
+// a CRC mismatch inside processCommandList is a trigger both sides observe at the
+// same frame (identical command list), so both schedule the same heal frame H with
+// no negotiation traffic. At H the sim freezes; the host streams a full save through
+// the retail network file transfer; the joiner loads it via GameState::loadGameForResync
+// (the stock loadGame would delete TheNetwork mid-match -- see GameState.cpp). Command
+// queues stay aligned at H by construction, so when both sides unfreeze they execute
+// frame H from the host's snapshot with identical inputs. Any failure path gives up
+// into cooldown and the match continues diverged, exactly as retail behaves today.
+// ------------------------------------------------------------------------------------------------
+static const char* const RESYNC_SAVE_NAME = "GXResync.sav";
+enum { RESYNC_TRANSFER_TIMEOUT_MS = 120000 };
+
+// ------------------------------------------------------------------------------------------------
+void GameLogic::resyncOnCRCMismatch()
+{
+	if (m_resyncState != RESYNC_IDLE)
+		return;
+	// LAN games only: the LANAPI singleton exists and owns the current game info.
+	if (!isInMultiplayerGame() || TheNetwork == nullptr || TheLAN == nullptr || TheGameInfo == nullptr)
+		return;
+	if (m_resyncHealsUsed >= RESYNC_MAX_HEALS)
+		return;
+
+	m_resyncState = RESYNC_PENDING;
+	m_resyncHealFrame = m_frame + RESYNC_HEAL_DELAY;
+	m_resyncSentFile = FALSE;
+	GX_NET_TRACE("RESYNC scheduled: heal at frame %u (detected at %u, heal %d of %d)\n",
+		(unsigned)m_resyncHealFrame, (unsigned)m_frame, m_resyncHealsUsed + 1, (int)RESYNC_MAX_HEALS);
+}
+
+// ------------------------------------------------------------------------------------------------
+Bool GameLogic::resyncIsFrozen()
+{
+	return (m_resyncState == RESYNC_HOST_SEND || m_resyncState == RESYNC_JOINER_WAIT);
+}
+
+// ------------------------------------------------------------------------------------------------
+void GameLogic::resyncFinishHeal( Bool success )
+{
+	m_resyncHealsUsed++;
+	m_resyncState = RESYNC_COOLDOWN;
+	m_resyncCooldownUntil = m_frame + RESYNC_COOLDOWN_FRAMES;
+	GX_NET_TRACE("RESYNC %s at frame %u (heals used %d); cooldown to frame %u\n",
+		success ? "healed" : "given up", (unsigned)m_frame, m_resyncHealsUsed,
+		(unsigned)m_resyncCooldownUntil);
+}
+
+// ------------------------------------------------------------------------------------------------
+void GameLogic::resyncUpdate()
+{
+	switch (m_resyncState)
+	{
+	case RESYNC_IDLE:
+		return;
+
+	case RESYNC_COOLDOWN:
+		if (m_frame >= m_resyncCooldownUntil)
+		{
+			m_resyncState = RESYNC_IDLE;
+			GX_NET_TRACE("RESYNC cooldown over at frame %u\n", (unsigned)m_frame);
+		}
+		return;
+
+	case RESYNC_PENDING:
+	{
+		if (m_frame < m_resyncHealFrame || TheGameInfo == nullptr || TheNetwork == nullptr)
+			return;
+
+		// The heal frame is reached: from here resyncIsFrozen() holds the sim
+		// until the heal completes or is given up.
+		m_resyncStartTime = timeGetTime();
+		if (TheGameInfo->amIHost())
+		{
+			m_resyncState = RESYNC_HOST_SEND;
+			SaveCode sc = TheGameState->saveGame(RESYNC_SAVE_NAME,
+				UnicodeString(L"LAN resync"), SAVE_FILE_TYPE_NORMAL);
+			if (sc != SC_OK)
+			{
+				GX_NET_TRACE("RESYNC host save failed (%d) at frame %u\n", (int)sc, (unsigned)m_frame);
+				resyncFinishHeal(FALSE);
+				return;
+			}
+			m_resyncTransferMask = 0;
+			for (Int i = 0; i < MAX_SLOTS; ++i)
+			{
+				const GameSlot *slot = TheGameInfo->getConstSlot(i);
+				if (slot != nullptr && slot->isHuman() && i != TheGameInfo->getLocalSlotNum())
+					m_resyncTransferMask |= (UnsignedByte)(1 << i);
+			}
+			AsciiString path = TheGameState->getFilePathInSaveDirectory(RESYNC_SAVE_NAME);
+			m_resyncFileCommandID = TheNetwork->sendFileAnnounce(path, m_resyncTransferMask);
+			GX_NET_TRACE("RESYNC host streaming state to mask %X at frame %u\n",
+				(unsigned)m_resyncTransferMask, (unsigned)m_frame);
+		}
+		else
+		{
+			m_resyncState = RESYNC_JOINER_WAIT;
+			GX_NET_TRACE("RESYNC joiner waiting for state at frame %u\n", (unsigned)m_frame);
+		}
+		return;
+	}
+
+	case RESYNC_HOST_SEND:
+	{
+		AsciiString path = TheGameState->getFilePathInSaveDirectory(RESYNC_SAVE_NAME);
+		if (!m_resyncSentFile)
+		{
+			// Mirror the lobby map transfer: announce first, send once the
+			// command queues have drained so the chunks own the channel.
+			if (TheNetwork->areAllQueuesEmpty())
+			{
+				TheNetwork->sendFile(path, m_resyncTransferMask, m_resyncFileCommandID);
+				m_resyncSentFile = TRUE;
+			}
+		}
+		else
+		{
+			Bool allDone = TRUE;
+			for (Int i = 0; i < MAX_SLOTS; ++i)
+			{
+				if (m_resyncTransferMask & (1 << i))
+				{
+					if (TheNetwork->getFileTransferProgress(i, path) < 100)
+						allDone = FALSE;
+				}
+			}
+			if (allDone)
+			{
+				resyncFinishHeal(TRUE);
+				return;
+			}
+		}
+		if (timeGetTime() - m_resyncStartTime > RESYNC_TRANSFER_TIMEOUT_MS)
+		{
+			GX_NET_TRACE("RESYNC host transfer timed out at frame %u\n", (unsigned)m_frame);
+			resyncFinishHeal(FALSE);
+		}
+		return;
+	}
+
+	case RESYNC_JOINER_WAIT:
+	{
+		AsciiString path = TheGameState->getFilePathInSaveDirectory(RESYNC_SAVE_NAME);
+		if (TheNetwork->getFileTransferProgress(TheGameInfo->getLocalSlotNum(), path) >= 100)
+		{
+			// Identity is derived from the local IP (GameInfo::getLocalSlotNum),
+			// and the loaded GameInfo carries the host's -- hand ours back before
+			// anything asks who we are. The load also resets this very object, so
+			// carry the heal count across in locals and let resyncFinishHeal
+			// re-establish the protocol state on the fresh members afterwards.
+			UnsignedInt myIP = TheGameInfo->getLocalIP();
+			Int healsUsed = m_resyncHealsUsed;
+			SaveCode sc = TheGameState->loadGameForResync(RESYNC_SAVE_NAME);
+			if (sc == SC_OK)
+			{
+				TheGameInfo->setLocalIP(myIP);
+				m_resyncHealsUsed = healsUsed;
+				GX_NET_TRACE("RESYNC joiner loaded host state at frame %u\n", (unsigned)m_frame);
+				resyncFinishHeal(TRUE);
+			}
+			else
+			{
+				GX_NET_TRACE("RESYNC joiner load failed (%d) at frame %u\n", (int)sc, (unsigned)m_frame);
+				resyncFinishHeal(FALSE);
+			}
+			return;
+		}
+		if (timeGetTime() - m_resyncStartTime > RESYNC_TRANSFER_TIMEOUT_MS)
+		{
+			GX_NET_TRACE("RESYNC joiner timed out waiting for state at frame %u\n", (unsigned)m_frame);
+			resyncFinishHeal(FALSE);
+		}
+		return;
+	}
+	}
+}
