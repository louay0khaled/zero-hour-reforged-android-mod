--- a/Core/GameEngine/Source/GameLogic/System/GameLogicDispatch.cpp
+++ b/Core/GameEngine/Source/GameLogic/System/GameLogicDispatch.cpp
@@ -1004,6 +1004,15 @@ bool GameLogic::onNewGame(MAYBE_UNUSED GameMessage *msg)
 			// frames per retail one, so the same speed needs twice the frame rate there;
 			// unscaled, "normal" would play at half speed.
 			maxFPS *= GENERALS_ONLINE_HIGH_FPS_FRAME_MULTIPLIER;
+#endif
+#if defined(REFORGED_60_STEPS) && !defined(GENERALS_ONLINE_HIGH_FPS_SERVER)
+			// GeneralsX @bugfix Zero Hour Reforged 12/11/2026 The Reforged 60-steps engine
+			// (libmainrf60.so) is not the GeneralsOnline 60 Hz engine: SAGE_HIGH_FPS_SIM is
+			// OFF in this build, so the multiplier above is 1 and the slider's retail value
+			// (30 = normal speed) would cap the render at 30 fps, advancing the 60-steps
+			// simulation at half game speed. Scale by the build's own logic-rate ratio
+			// instead, so every slider position means the same game speed in both engines.
+			maxFPS *= LOGICFRAMES_PER_RETAIL_FRAME;
 #endif
 		}
