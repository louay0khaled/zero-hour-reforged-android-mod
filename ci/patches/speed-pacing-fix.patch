diff --git a/Core/GameEngine/Source/GameNetwork/Network.cpp b/Core/GameEngine/Source/GameNetwork/Network.cpp
index da9e9e6..987c489 100644
--- a/Core/GameEngine/Source/GameNetwork/Network.cpp
+++ b/Core/GameEngine/Source/GameNetwork/Network.cpp
@@ -334,7 +334,11 @@ void Network::init()
 
 	m_lastFrame = 0;
 	m_runAhead = min(max(30, MIN_RUNAHEAD), MAX_FRAMES_AHEAD/2); ///< @todo: don't hard-code the run-ahead.
-	m_frameRate = 30;
+	// GeneralsX @bugfix Zero Hour Reforged 12/11/2026 The session pace is the build's own
+	// logic rate: a logic step is 1/LOGICFRAMES_PER_SECOND of game time, so pacing the
+	// session at any other rate changes the game speed. Both ends of a same-rate session
+	// run the same build, so they agree on this value by construction.
+	m_frameRate = LOGICFRAMES_PER_SECOND;
 	m_lastExecutionFrame = m_runAhead - 1; // subtract 1 since we're starting on frame 0
 	m_lastFrameCompleted = m_runAhead - 1; // subtract 1 since we're starting on frame 0
 	m_frameDataReady = FALSE;
